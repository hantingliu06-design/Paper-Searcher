# Copy to .env. Never commit the real .env or private journal metrics.
# Demo and Crossref search work without any credentials.

# Optional: LLM research planning through OpenAI Responses + Structured Outputs.
# Set a model available to your account that supports Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: broader metadata, abstracts and citations from OpenAlex.
OPENALEX_API_KEY=

# Required only for automatic Google Scholar checks via SerpAPI.
SERPAPI_API_KEY=

# Optional: your licensed/exported JIF CSV or JSON. Relative to launch directory.
# CSV fields: issn,impact_factor,year,source
IMPACT_FACTOR_FILE=
